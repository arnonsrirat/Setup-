local monitor = peripheral.find("monitor")
local modem = peripheral.find("modem")

if not monitor then
    error("Monitor not found")
end

if not modem then
    error("Modem not found")
end

rednet.open(peripheral.getName(modem))

monitor.setTextScale(1)

local mode = "text"

local line1 = "WAITING"
local line2 = "FOR SERVER"
local line3 = "[ OFFLINE ]"

local animColors = {
    colors.cyan,
    colors.lightBlue,
    colors.purple,
    colors.magenta
}

local frame = 1

local function center(text, y, color)
    local w, h = monitor.getSize()

    monitor.setTextColor(color or colors.white)

    local x = math.floor((w - #text) / 2) + 1
    if x < 1 then x = 1 end

    monitor.setCursorPos(x, y)
    monitor.write(text)
end

local function drawText()
    local w, h = monitor.getSize()

    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    monitor.setTextColor(animColors[frame])
    monitor.setCursorPos(1, 1)
    monitor.write(string.rep("=", w))

    local middle = math.floor(h / 2)

    center(line1, middle - 1, animColors[frame])
    center(line2, middle, colors.white)
    center(line3, middle + 1, colors.lime)

    monitor.setTextColor(animColors[frame])
    monitor.setCursorPos(1, h)
    monitor.write(string.rep("=", w))

    frame = frame + 1
    if frame > #animColors then
        frame = 1
    end
end

local function showImage(url)
    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    local response = http.get(url)

    if not response then
        center("MEDIA ERROR", 2, colors.red)
        center("DOWNLOAD FAILED", 3, colors.white)
        return
    end

    local data = response.readAll()
    response.close()

    local path = "/tmp_screen.nfp"

    local file = fs.open(path, "w")
    file.write(data)
    file.close()

    local image = paintutils.loadImage(path)

    if not image then
        monitor.clear()
        center("INVALID IMAGE", 2, colors.red)
        return
    end

    local old = term.redirect(monitor)

    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    paintutils.drawImage(image, 1, 1)

    term.redirect(old)
end

while true do

    if mode == "text" then
        drawText()
    end

    local timer = os.startTimer(0.3)

    while true do
        local event, p1, p2, p3 = os.pullEvent()

        if event == "timer" and p1 == timer then
            break
        end

        if event == "rednet_message" then
            local sender = p1
            local message = p2
            local protocol = p3

            if protocol == "sign_network"
            and type(message) == "table" then

                if message.mode == "text" then

                    mode = "text"

                    line1 = tostring(message.line1 or "")
                    line2 = tostring(message.line2 or "")
                    line3 = tostring(message.line3 or "")

                    drawText()

                elseif message.mode == "image" then

                    mode = "image"

                    showImage(message.url)

                end
            end
        end
    end
end
