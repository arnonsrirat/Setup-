local modem = peripheral.find("modem")

if not modem then
    error("No modem found")
end

rednet.open(peripheral.getName(modem))

local signs = {
    quantumcraft = 8,
    treefarm = 9
}

while true do

    print("")
    print("=== SIGN CONTROL ===")
    print("1 = Quantum Craft")
    print("2 = Tree Farm")
    print("3 = ALL")

    write("Select sign: ")
    local choice = read()

    write("Message: ")
    local message = read()

    if choice == "1" then

        rednet.send(
            signs.quantumcraft,
            message,
            "sign_network"
        )

        print("Sent to Quantum Craft")

    elseif choice == "2" then

        rednet.send(
            signs.treefarm,
            message,
            "sign_network"
        )

        print("Sent to Tree Farm")

    elseif choice == "3" then

        rednet.broadcast(
            message,
            "sign_network"
        )

        print("Sent to ALL")

    else
        print("Invalid option")
    end

end
